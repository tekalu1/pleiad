# scripts/release-info.mjs が LF で書き出す生成物で、npm test のたびにも書き直される。
# core.autocrlf=true の環境では CRLF で取り出されるため、書き直すたびに「変更あり」になる。作業ツリーでも LF に固定する
web/release-info.json text eol=lf
# pleiad CLI の起動口（ADR 0090）。シェルスクリプトは CRLF だと sh が読めず、.cmd は LF だと goto の飛び先を見失うことがある
bin/pleiad text eol=lf
bin/pleiad.cmd text eol=crlf
# 審査用のホストの起動口（ADR 0172）。CRLF だと Linux の sh が読めない
deploy/review-host/*.sh text eol=lf
